# ─── Database ────────────────────────────────────────────────────────────────
# Neon / Supabase PostgreSQL pooled connection string (for queries)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Neon direct connection string (unpooled, needed for Prisma migrations)
# Format: postgresql://USER:PASSWORD@HOST-direct/DBNAME?sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# ─── AI ──────────────────────────────────────────────────────────────────────
# Groq (free tier, no card needed — https://console.groq.com/keys). Preferred when set.
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="openai/gpt-oss-120b"

# Google AI Studio API Key (optional — falls back to deterministic rule engine if missing)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Current recommended Gemini model name
AI_MODEL="gemini-3.8-flash"

# ─── App URL (needed for NextAuth in production) ──────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
